{
  "name": "pi-browser-agent",
  "version": "0.8.1",
  "description": "A Chrome-native AI assistant with bounded browser tools",
  "type": "module",
  "private": true,
  "keywords": [
    "chrome-extension",
    "browser-automation",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-browser-agent.git"
  },
  "scripts": {
    "audit:artifact": "node scripts/audit-artifact.mjs",
    "build": "npm run probe:browser && npm run build:chrome && npm run typecheck && npm run audit:artifact",
    "build:chrome": "extension build --browser=chrome",
    "changeset": "changeset",
    "check": "biome ci .",
    "ci": "npm run check && npm test && npm run build && npm run test:e2e",
    "dev:chrome": "extension dev --browser=chrome",
    "pack": "npm run build && extension build --browser=chrome --zip --zip-filename=pi-browser-agent.zip",
    "prepare": "husky",
    "probe:browser": "node scripts/probe-browser-boundary.mjs",
    "release": "changeset publish",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/extension-smoke.spec.ts",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version && node scripts/sync-manifest-version.mjs && npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "typebox": "^1.4.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "extension": "^4.1.35",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
