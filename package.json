{
  "name": "pi-chrome",
  "version": "0.1.0",
  "description": "A Chrome-native Codex assistant with bounded browser tools",
  "type": "module",
  "private": true,
  "keywords": [
    "chrome-extension",
    "browser-automation",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-chrome.git"
  },
  "scripts": {
    "audit:artifact": "node scripts/audit-artifact.mjs",
    "build": "npm run probe:browser && npm run build:chrome && npm run typecheck && npm run audit:artifact",
    "build:chrome": "extension build --browser=chrome",
    "check": "biome ci .",
    "ci": "npm run check && npm test && npm run build && npm run test:e2e",
    "dev:chrome": "extension dev --browser=chrome",
    "package:chrome": "npm run build && extension build --browser=chrome --zip --zip-filename=pi-chrome.zip",
    "prepare": "husky",
    "probe:browser": "node scripts/probe-browser-boundary.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "typebox": "^1.3.31"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.301",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.1",
    "extension": "^4.1.19",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
