{
  "manifest_version": 3,
  "name": "Pi Chrome",
  "description": "A Chrome-native AI assistant for the page you are viewing.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "tabs"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": [
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/browser/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open Pi Chrome",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/browser/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https:"
  }
}
