{
  "manifest_version": 3,
  "name": "Pi Chrome",
  "description": "A Chrome-native Codex assistant for the page you are viewing.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage", "tabs"],
  "optional_host_permissions": [
    "https://auth.openai.com/*",
    "https://chatgpt.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/browser/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open Pi Chrome"
  },
  "side_panel": {
    "default_path": "src/browser/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://auth.openai.com https://chatgpt.com"
  }
}
